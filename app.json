{
  "expo": {
    "name": "Breakroom",
    "slug": "breakroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/breakroom-playstore-icon.png",
    "scheme": "breakroom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.boredapp.breakroom",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#172B4D",
        "foregroundImage": "./assets/images/breakroom-playstore-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en", "hi", "es", "fr", "de", "pt", "ar", "ja", "ta", "id"],
            "ios": ["en", "hi", "es", "fr", "de", "pt", "ar", "ja", "ta", "id"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8657845-0b0a-4ac7-b091-74f96117bee8"
      }
    },
    "owner": "rickc137"
  }
}
