{
  "expo": {
    "name": "Breakroom",
    "slug": "breakroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/breakroom-playstore-icon.png",
    "scheme": "breakroom",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#172325",
    "primaryColor": "#2C8B83",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.boredapp.breakroom",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2B393B",
        "foregroundImage": "./assets/images/breakroom-playstore-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "themeColor": "#2B393B",
      "backgroundColor": "#F4F1EB",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Breakroom to use your location only when you choose to attach your city or area to an Office Pulse."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B393B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en", "hi", "es", "fr", "de", "pt", "ar", "ja", "ta", "id"],
            "ios": ["en", "hi", "es", "fr", "de", "pt", "ar", "ja", "ta", "id"]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D45D45",
          "defaultChannel": "breakroom-alerts-v3",
          "sounds": [
            "./assets/sounds/paper_plane_landing.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8657845-0b0a-4ac7-b091-74f96117bee8"
      }
    },
    "owner": "rickc137"
  }
}
